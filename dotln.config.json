{
  "version": 1,
  "classes": {
    "angular-nx-monorepo": {
      "checks": [],
      "supports": [],
      "disposable": [
        ".angular",
        ".nx",
        ".runtime",
        "__screenshots__",
        "coverage",
        "dist",
        "docs/control/local",
        "libs/dotln/shell/node_modules",
        "libs/features/board-data-access/node_modules",
        "libs/features/board/node_modules",
        "libs/features/machinery/node_modules",
        "libs/features/scene-data-access/node_modules",
        "libs/features/scene/node_modules",
        "libs/features/tools/node_modules",
        "libs/shared/catalog/node_modules",
        "libs/shared/core/node_modules",
        "libs/shared/data-access/node_modules",
        "libs/shared/events/node_modules",
        "libs/shared/i18n/node_modules",
        "libs/shared/models/node_modules",
        "libs/shared/scene-engine/node_modules",
        "libs/shared/state/node_modules",
        "libs/shared/ui/node_modules",
        "libs/shared/utils/node_modules",
        "node_modules",
        "out-tsc",
        "playwright-report",
        "test-output",
        "test-results",
        "tmp"
      ]
    }
  },
  "release": {
    "displayName": "Launchpad"
  },
  "contributions": {
    "operatorAuthor": "Dylan Wood <dylanwoodconsulting@gmail.com>"
  },
  "repositories": {
    "dotln-angular": {
      "baseBranch": "main",
      "worktreeParent": "..",
      "repositoryClass": "angular-nx-monorepo",
      "profile": "docs/repositories/dotln-angular.md",
      "release": {
        "policy": "declared",
        "displayName": "DotLn Angular"
      },
      "baseDisposablePolicy": "judge-only",
      "documentationRoot": "docs/dotln",
      "authorityProfile": {
        "authorityEnvelopeId": "target-orders",
        "allowedEffects": [
          "repo.read",
          "repo.write",
          "repo.delete",
          "git.local",
          "shell.run",
          "repo.push",
          "pr.open",
          "pr.thread.resolve",
          "release.close"
        ],
        "deniedEffects": [
          "package.publish"
        ],
        "resourceLimits": {
          "writers": 1
        },
        "requiredEvidence": [],
        "expiresAt": 4102444800000,
        "revocationEventTypes": [
          "AuthorityRevoked"
        ]
      },
      "gate": {
        "commands": {
          "install": {
            "argv": [
              "env",
              "NX_DAEMON=false",
              "NX_ISOLATE_PLUGINS=false",
              "npm",
              "ci"
            ],
            "timeoutMs": 600000
          },
          "lint": {
            "argv": [
              "env",
              "NX_DAEMON=false",
              "NX_ISOLATE_PLUGINS=false",
              "npx",
              "nx",
              "run-many",
              "-t",
              "lint"
            ],
            "timeoutMs": 600000
          },
          "typecheck": {
            "argv": [
              "env",
              "NX_DAEMON=false",
              "NX_ISOLATE_PLUGINS=false",
              "npm",
              "run",
              "typecheck:e2e"
            ],
            "timeoutMs": 600000
          },
          "test": {
            "argv": [
              "env",
              "NX_DAEMON=false",
              "NX_ISOLATE_PLUGINS=false",
              "npx",
              "nx",
              "run-many",
              "-t",
              "test"
            ],
            "timeoutMs": 900000
          },
          "format": {
            "argv": [
              "env",
              "NX_DAEMON=false",
              "NX_ISOLATE_PLUGINS=false",
              "npx",
              "nx",
              "format:check"
            ],
            "timeoutMs": 600000
          },
          "build": {
            "argv": [
              "env",
              "NX_DAEMON=false",
              "NX_ISOLATE_PLUGINS=false",
              "npx",
              "nx",
              "run-many",
              "-t",
              "build"
            ],
            "timeoutMs": 900000
          },
          "e2e": {
            "argv": [
              "env",
              "NX_DAEMON=false",
              "NX_ISOLATE_PLUGINS=false",
              "npx",
              "nx",
              "run-many",
              "-t",
              "e2e"
            ],
            "timeoutMs": 1200000
          },
          "visual": {
            "argv": [
              "env",
              "NX_DAEMON=false",
              "NX_ISOLATE_PLUGINS=false",
              "npx",
              "nx",
              "e2e-visual",
              "dotln-e2e"
            ],
            "timeoutMs": 1200000
          }
        },
        "plain": [
          "install",
          "lint",
          "typecheck",
          "test",
          "format"
        ],
        "review": [
          "install",
          "lint",
          "typecheck",
          "test",
          "format",
          "build",
          "e2e",
          "visual"
        ]
      }
    }
  }
}
